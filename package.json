{
  "name": "atono-matsuri",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.2",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@atono/shared && npm run build --workspace=@atono/server && npm run build --workspace=@atono/web",
    "typecheck": "npm run build --workspace=@atono/shared && npm run typecheck --workspaces",
    "start": "npm run start --workspace=@atono/server"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
